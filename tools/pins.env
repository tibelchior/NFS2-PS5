# NFS II SE PS5 port via zaps166/NFSIISE (wrapper MIT; src/Asm and src/Cpp from its submodules): copy in repo/, patched by tools/port.py.
# SDL2 2.28.5 tree reused from the UT99 port (patched copy is made in the build volume)
# (override with SDL2_SRC=<folder>)
SDL2_SRC_REL=pc-source/UT99/UT99-Android/third_party/SDL2
PS5_VULKAN_REPO=https://github.com/mihawk-99/PS5_Vulkan.git
PS5_VULKAN_COMMIT=7f492b4c6f67a4e8c8c67a4272cfeef22abea9cc
PS5_PAYLOADSDK_REPO=https://github.com/mihawk-99/PS5_PayloadSDK.git
PS5_PAYLOADSDK_COMMIT=3345cde7441f2d5f5432dd6d4f494cacbc974e28
PS5_MESA_REPO=https://github.com/mihawk-99/PS5_Mesa.git
PS5_MESA_COMMIT=0f86253f674c425052948eb3cb116c81e646a734
TITLE_ID=PPSA99789
# upstream game sources (tools/fetch-upstream.sh clones these into repo/)
NFSIISE_REPO=https://github.com/zaps166/NFSIISE
NFSIISE_COMMIT=66cbaf4
NFSIISE_ASM_REPO=https://github.com/zaps166/NFSIISE-ASM
NFSIISE_ASM_COMMIT=7b8ad75fddac7ce6cd13e2d4b482128925e2a13f
